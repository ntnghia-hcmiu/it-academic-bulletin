---
layout: layouts/base.njk
permalink: /bieu-mau/
title: Biểu mẫu / Tài liệu
description: Biểu mẫu và tài liệu theo danh mục học vụ.
---
{% from "components/EmptyState.njk" import emptyState %}
{% from "components/ResourceList.njk" import resourceList %}
{% set byCategory = bulletin.resources | groupby('resolvedCategory.slug') %}
<h1>Biểu mẫu / Tài liệu</h1>
{% for category in bulletin.categories.concat([{ slug: 'khac', name: 'Khác' }]) %}
  {% set resources = byCategory[category.slug] or [] %}
  {% if resources.length %}
    <section class="page-section" aria-labelledby="resources-{{ category.slug | escape }}">
      <h2 id="resources-{{ category.slug | escape }}">{{ category.name | escape }}</h2>
      {{ resourceList(resources) }}
    </section>
  {% endif %}
{% endfor %}
{% if not bulletin.resources.length %}{{ emptyState('Chưa có biểu mẫu / tài liệu', 'Nội dung đang được cập nhật') }}{% endif %}
