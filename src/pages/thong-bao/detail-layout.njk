---
layout: layouts/base.njk
permalink: false
noindex: true
eleventyExcludeFromCollections: true
---
{% from "components/DeadlineBadge.njk" import displayDate, deadlineBadge, refreshDeadlines %}
{% from "components/AttachmentList.njk" import attachmentList %}
{# This layout is also discovered as a template; permalink:false suppresses output. #}
{% if announcement %}
<p><a href="/thong-bao/">Tất cả thông báo</a></p>
<article class="announcement-detail">
  <h1>{{ announcement.title | escape }}</h1>
  <div class="announcement-meta">
    {% if announcement.resolvedCategory.slug != 'khac' %}
      <a href="/danh-muc/{{ announcement.resolvedCategory.slug | escape }}/">{{ announcement.resolvedCategory.name | escape }}</a>
    {% else %}
      <span>{{ announcement.resolvedCategory.name | escape }}</span>
    {% endif %}
    <span>Ngày đăng: <time datetime="{{ announcement.published_date | escape }}">{{ displayDate(announcement.published_date) }}</time></span>
    {% if announcement.important %}<span class="important-label">Quan trọng</span>{% endif %}
  </div>
  {{ deadlineBadge(announcement.deadline, build) }}
  {% if announcement.summary %}<p class="intro">{{ announcement.summary | escape }}</p>{% endif %}
  {# All links generated by Markdown receive the external-link rel policy. #}
  <div class="prose">{{ content | replace('<a ', '<a rel="noopener noreferrer" ') | safe }}</div>
  {% if announcement.attachments.length %}
    <section class="page-section" aria-labelledby="attachments-title">
      <h2 id="attachments-title">Tệp và đường dẫn đính kèm</h2>
      {{ attachmentList(announcement.attachments) }}
    </section>
  {% endif %}
</article>
{{ refreshDeadlines() }}
{% endif %}
